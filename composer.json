{
    "name": "laravel/head",
    "description": "First-party head management for Laravel applications",
    "keywords": ["laravel", "head", "seo", "metadata"],
    "homepage": "https://github.com/laravel/head",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/laravel/head/issues",
        "source": "https://github.com/laravel/head"
    },
    "authors": [
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^3.1",
        "laravel/pint": "^1.28.0",
        "livewire/livewire": "^4.3",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Laravel\\Head\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laravel\\Head\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laravel\\Head\\HeadServiceProvider"
            ],
            "aliases": {
                "Head": "Laravel\\Head\\Facades\\Head"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": "pint",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse",
        "test:unit": "pest",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
